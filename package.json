{
  "name": "nftc-india",
  "version": "3.0.0",
  "private": true,
  "description": "Website for the National Federation of Tourism & Transport Co-operatives of India Ltd",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "images": "python3 scripts/optimize-images.py",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^16.3.8",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
