{
  // Cloudflare Worker: serves the static export in out/ and handles POST /api/enquiry.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nftc-new",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // `wrangler deploy` and `wrangler dev` run the Next.js static export first, so Cloudflare's
  // GitHub builds work with deploy command `npx wrangler deploy` and no separate build command.
  "build": { "command": "npm run build", "watch_dir": ["app", "components", "lib", "content", "public"] },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /about serves about.html; /about.html and /about/ redirect to /about
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // 5 form submissions per minute per IP
  "ratelimits": [{ "name": "ENQUIRY_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": {
    "ENQUIRY_TO": "info@nftcindia.in",
    "ENQUIRY_FROM": "NFTCI Website <website@send.nftcindia.in>"
  }
  // Secret (not in git): wrangler secret put RESEND_API_KEY
}
